# Copy this file to .env and fill in real values. Never commit .env.
# All values below are non-functional placeholders.

# --- Database (PostgreSQL) ---
# Used by packages/db (Prisma) and apps/api
DATABASE_URL="postgresql://nyayalens:nyayalens_dev_password@localhost:5432/nyayalens_dev?schema=public"

# --- API service ---
API_PORT=4000
NODE_ENV=development

# JWT signing secrets. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh secrets MUST be different values.
JWT_ACCESS_SECRET="replace_with_a_random_64_char_hex_secret_for_access_tokens"
JWT_REFRESH_SECRET="replace_with_a_different_random_64_char_hex_secret_for_refresh"

# Issuer/audience are validated on every request - keep them stable per environment.
JWT_ISSUER="nyayalens-api"
JWT_AUDIENCE="nyayalens-client"

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id password hashing cost parameters (see docs/architecture/auth.md)
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Storage / uploads ---
# Local-disk storage adapter root (relative to the API process's cwd
# unless absolute). See apps/api/src/storage/.
STORAGE_ROOT="storage"
MAX_UPLOAD_SIZE_MB=20

# Path to the Python interpreter inside services/ml/.venv (see
# services/ml/README.md for setup). Leave empty to skip the
# generic-transformer NER baseline - the rest of the pipeline still runs.
ML_SERVICE_PYTHON=""

# --- Web app ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# --- RAG (Phase 7A) ---
# Which LLMProvider answers POST /documents/:id/ask questions. "extractive"
# (default) is the only provider verified working in this environment - no
# LLM API key is configured anywhere here. "anthropic" activates
# AnthropicProvider only if ANTHROPIC_API_KEY is also set (implemented but
# NOT verified - see docs/architecture/rag_design.md); the factory falls
# back to "extractive" with a logged warning otherwise.
LLM_PROVIDER="extractive"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
