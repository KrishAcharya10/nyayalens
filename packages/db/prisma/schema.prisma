// NyayaLens database schema (Phase 1-2).
//
// Scope note: this schema covers repository/database/auth setup only.
// Tables that will eventually hold ML-derived output (document_pages,
// document_sections, document_clauses, entities, relations, risks,
// obligations, embeddings) are reserved here with a `documentId` foreign
// key and nullable provenance fields so later phases (NER, clause
// classification, relation extraction, risk engine, embeddings) can
// populate them without a breaking schema migration. No extraction,
// NER, embedding, or risk-detection logic is implemented in this phase.
//
// See docs/architecture/database.md, docs/architecture/schema.md and
// docs/architecture/provenance.md for the design rationale.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum Role {
  USER
  ADMIN

  @@map("role")
}

// Restricted to the two document types NyayaLens supports. Commercial
// leases and general contracts are explicitly out of scope.
enum DocumentType {
  RESIDENTIAL_RENTAL @map("residential_rental")
  LAND_LEASE         @map("land_lease")

  @@map("document_type")
}

// TODO_PROCESSING_JOB_TYPES: replace `ProcessingJob.jobType` (currently a
// free-text string) with an enum once the pipeline stages introduced in
// Phase 3+ (extraction, NER, clause classification, risk analysis, ...)
// are finalized.
enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@map("processing_job_status")
}

// ---------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documents     Document[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

// One row per issued refresh token (hash only - the raw token is never
// stored). Rotation: on use, the current row is marked revoked and
// `replacedByTokenHash` points at the newly issued token's hash. All
// tokens sharing a `familyId` can be revoked together if reuse of an
// already-rotated token is detected, which is a common signal of theft.
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique @map("token_hash")
  familyId            String    @map("family_id")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdByIp         String?   @map("created_by_ip")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------

model Document {
  id             String       @id @default(uuid())
  ownerId        String       @map("owner_id")
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  documentType   DocumentType @map("document_type")
  // True for documents ingested from research/data/synthetic (matches the
  // `metadata.is_synthetic` field already present in the synthetic
  // dataset's *.labels.json files). Must always be surfaced alongside any
  // metric or result derived from this document - synthetic and
  // real-document results must never be blended or presented as
  // equivalent evidence of real-world generalization.
  isSynthetic    Boolean      @default(false) @map("is_synthetic")
  sourceFilename String?      @map("source_filename")
  // Canonical extracted text. Populated by a future ingestion phase.
  canonicalText  String?      @map("canonical_text")
  // Reserved for the top-level "key findings" digest (spec Section 11).
  // Shape documented in docs/architecture/schema.md. Not populated until
  // risk analysis and missing-clause detection exist.
  keyFindings    Json?        @map("key_findings")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  pages          DocumentPage[]
  sections       DocumentSection[]
  clauses        DocumentClause[]
  entities       Entity[]
  relations      Relation[]
  risks          Risk[]
  obligations    Obligation[]
  embeddings     Embedding[]
  processingJobs ProcessingJob[]

  @@index([ownerId])
  @@index([documentType])
  @@map("documents")
}

model DocumentPage {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int      @map("page_number")
  text       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

model DocumentSection {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String?
  order      Int?
  // Canonical text provenance (see docs/architecture/provenance.md)
  textStart  Int?     @map("text_start")
  textEnd    Int?     @map("text_end")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_sections")
}

// A labeled clause span (e.g. RENT_PAYMENT, TERMINATION, DISPUTE_RESOLUTION).
// clauseType is free text in this phase; a controlled ontology enum lands
// with the clause-classification phase.
model DocumentClause {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  clauseType   String   @map("clause_type")
  clauseNumber String?  @map("clause_number")
  text         String?

  // --- Canonical text provenance ---
  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  // --- Visual/page provenance (nullable until PDF layout extraction exists) ---
  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_clauses")
}

// A labeled entity span (e.g. RENT, LESSOR, LAND_AREA, SURVEY_NUMBER).
model Entity {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label      String
  text       String?

  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  relationsAsSubject Relation[] @relation("RelationSubject")
  relationsAsObject  Relation[] @relation("RelationObject")

  @@index([documentId])
  @@index([label])
  @@map("entities")
}

// A directed relation between two entities in the same document
// (e.g. LESSOR -> owns -> SURVEY_NUMBER).
model Relation {
  id              String   @id @default(uuid())
  documentId      String   @map("document_id")
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  subjectEntityId String   @map("subject_entity_id")
  subjectEntity   Entity   @relation("RelationSubject", fields: [subjectEntityId], references: [id], onDelete: Cascade)
  objectEntityId  String   @map("object_entity_id")
  objectEntity    Entity   @relation("RelationObject", fields: [objectEntityId], references: [id], onDelete: Cascade)
  relationType    String   @map("relation_type")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("relations")
}

// A flagged risk finding. severity/category are free text in this phase;
// controlled vocabularies land with the risk engine.
model Risk {
  id       String  @id @default(uuid())
  documentId String @map("document_id")
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  severity String?
  category String?
  reason   String?

  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("risks")
}

// An extracted obligation (who owes what, optionally by when).
model Obligation {
  id           String    @id @default(uuid())
  documentId   String    @map("document_id")
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  obligedParty String?   @map("obliged_party")
  description  String?
  dueDate      DateTime? @map("due_date")

  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("obligations")
}

// Placeholder for future vector search. `vector` is a JSON array of
// floats for now; a future migration will add the pgvector extension and
// a native `vector` column (see docs/architecture/database.md). No
// pgvector extension, column type, or dependency is added in this phase.
model Embedding {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceTable String   @map("source_table")
  sourceId    String   @map("source_id")
  modelName   String?  @map("model_name")
  dimension   Int?
  vector      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("embeddings")
}

// Tracks an async processing step for a document (e.g. a future
// extraction or NER run). No job is ever created or executed in this
// phase - the table exists so later phases don't need a migration to
// start recording job state.
model ProcessingJob {
  id           String              @id @default(uuid())
  documentId   String              @map("document_id")
  document     Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  jobType      String              @map("job_type")
  status       ProcessingJobStatus @default(PENDING)
  errorMessage String?             @map("error_message")
  startedAt    DateTime?           @map("started_at")
  finishedAt   DateTime?           @map("finished_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([documentId])
  @@map("processing_jobs")
}

// ---------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}
