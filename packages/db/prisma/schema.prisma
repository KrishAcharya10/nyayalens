// NyayaLens database schema.
//
// Phase 1-2 established repository/database/auth. Phase 3 added upload +
// text extraction (documents.storage_key/mime_type/file_size_bytes,
// document_pages.extraction_method). Phase 4A added rule-based +
// generic-transformer NER and clause classification
// (entities/document_clauses.model_source). Phase 6 added the risk engine
// (risks.category/severity/pass/model_source/evidence,
// documents.is_adversarial/is_adversarial_control). document_sections,
// relations, obligations, and embeddings remain reserved-but-unpopulated
// for later phases (relation extraction, embeddings).
//
// See docs/architecture/database.md, docs/architecture/schema.md,
// docs/architecture/provenance.md, docs/architecture/document_ingestion.md
// and docs/architecture/extraction_pipeline.md for design rationale.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum Role {
  USER
  ADMIN

  @@map("role")
}

// Restricted to the two document types NyayaLens supports. Commercial
// leases and general contracts are explicitly out of scope.
enum DocumentType {
  RESIDENTIAL_RENTAL @map("residential_rental")
  LAND_LEASE         @map("land_lease")

  @@map("document_type")
}

// TODO_PROCESSING_JOB_TYPES: replace `ProcessingJob.jobType` (currently a
// free-text string) with an enum once the pipeline stages introduced in
// Phase 3+ (extraction, NER, clause classification, risk analysis, ...)
// are finalized.
enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@map("processing_job_status")
}

// How a DocumentPage's text was obtained. NATIVE = extracted directly from
// the PDF/DOCX's embedded text layer (pdfjs-dist / mammoth). OCR = the page
// had no usable native text (a scanned/image-only page) and was run through
// an OCR engine in Phase 4A. A page whose extraction_method is still NULL
// has native text pending-or-absent and has not been OCR'd yet - see
// docs/architecture/document_ingestion.md.
enum ExtractionMethod {
  NATIVE
  OCR

  @@map("extraction_method")
}

// Which extraction approach produced an Entity/DocumentClause row. Required
// on every row (Phase 3 never creates entities/clauses - only Phase 4A+
// does), so downstream evaluation code can group/compare by method without
// guessing. See docs/architecture/evaluation_design.md.
enum ModelSource {
  RULE_BASED          @map("rule_based")
  GENERIC_TRANSFORMER @map("generic_transformer")
  FINE_TUNED          @map("fine_tuned")

  @@map("model_source")
}

// The five risk categories from docs/research/adversarial_test_design.md,
// unchanged by Phase 6 (that design note is authoritative - this enum just
// makes it a controlled vocabulary instead of free text). MISSING_CLAUSE
// is category 5 ("clean absence").
enum RiskCategory {
  LIABILITY_SHIFT
  ASYMMETRIC_OBLIGATION
  UNBOUNDED_DISCRETION
  LAND_USE_CONTRADICTION
  MISSING_CLAUSE

  @@map("risk_category")
}

// See docs/architecture/risk_engine.md for the rubric each category maps
// to - this is a fixed lookup, not inferred per-finding.
enum RiskSeverity {
  LOW
  MEDIUM
  HIGH

  @@map("risk_severity")
}

// Which risk-engine pass produced a finding - see risk_engine.md. Pass 1
// (per-clause) never needs more than one clause's context; Pass 2
// (cross-clause/cross-entity) always compares two or more spans, which is
// why Risk.evidence is an array, not a single text_start/text_end pair.
enum RiskPass {
  PASS_1
  PASS_2

  @@map("risk_pass")
}

// ---------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documents     Document[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

// One row per issued refresh token (hash only - the raw token is never
// stored). Rotation: on use, the current row is marked revoked and
// `replacedByTokenHash` points at the newly issued token's hash. All
// tokens sharing a `familyId` can be revoked together if reuse of an
// already-rotated token is detected, which is a common signal of theft.
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique @map("token_hash")
  familyId            String    @map("family_id")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdByIp         String?   @map("created_by_ip")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------

model Document {
  id             String       @id @default(uuid())
  ownerId        String       @map("owner_id")
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  documentType   DocumentType @map("document_type")
  // True for documents ingested from research/data/synthetic (matches the
  // `metadata.is_synthetic` field already present in the synthetic
  // dataset's *.labels.json files). Must always be surfaced alongside any
  // metric or result derived from this document - synthetic and
  // real-document results must never be blended or presented as
  // equivalent evidence of real-world generalization.
  isSynthetic    Boolean      @default(false) @map("is_synthetic")
  // Phase 6: true for research/data/adversarial/ documents (both the
  // injected-risk positives and their matched controls) - kept distinctly
  // tagged from the ordinary bulk synthetic set so neither is ever used to
  // train/fine-tune anything, and so adversarial-set performance is never
  // blended with bulk-set numbers. See docs/architecture/adversarial_evaluation_results.md.
  isAdversarial  Boolean      @default(false) @map("is_adversarial")
  // True for a matched control (expected_flag = NONE - same structure/
  // vocabulary as its category's positive cases, minus the injected risk
  // condition). Only meaningful when isAdversarial is true.
  isAdversarialControl Boolean @default(false) @map("is_adversarial_control")
  sourceFilename String?      @map("source_filename")
  // Where the uploaded original file lives in the storage adapter (see
  // apps/api/src/storage/), the client-reported MIME type, and its size in
  // bytes. Set at upload time by Phase 3; null for rows that never went
  // through upload (e.g. synthetic seed metadata, which has no stored file).
  storageKey     String?      @map("storage_key")
  mimeType       String?      @map("mime_type")
  fileSizeBytes  Int?         @map("file_size_bytes")
  // Canonical extracted text. Populated by Phase 3's extraction job.
  canonicalText  String?      @map("canonical_text")
  // Reserved for the top-level "key findings" digest (spec Section 11).
  // Shape documented in docs/architecture/schema.md. Not populated until
  // risk analysis and missing-clause detection exist.
  keyFindings    Json?        @map("key_findings")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  pages          DocumentPage[]
  sections       DocumentSection[]
  clauses        DocumentClause[]
  entities       Entity[]
  relations      Relation[]
  risks          Risk[]
  obligations    Obligation[]
  embeddings     Embedding[]
  processingJobs ProcessingJob[]

  @@index([ownerId])
  @@index([documentType])
  @@map("documents")
}

model DocumentPage {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int      @map("page_number")
  text       String?
  // NULL = no usable native text found yet and not OCR'd (deferred to
  // Phase 4A). Set to NATIVE or OCR once text is actually populated.
  extractionMethod ExtractionMethod? @map("extraction_method")
  // Only meaningful when extractionMethod = OCR.
  ocrConfidence     Float?            @map("ocr_confidence")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

model DocumentSection {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String?
  order      Int?
  // Canonical text provenance (see docs/architecture/provenance.md)
  textStart  Int?     @map("text_start")
  textEnd    Int?     @map("text_end")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_sections")
}

// A labeled clause span (e.g. RENT_PAYMENT, TERMINATION, DISPUTE_RESOLUTION).
// clauseType is free text in this phase; a controlled ontology enum lands
// with the clause-classification phase.
model DocumentClause {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  clauseType   String   @map("clause_type")
  clauseNumber String?  @map("clause_number")
  text         String?

  // --- Canonical text provenance ---
  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  // --- Visual/page provenance (nullable until PDF layout extraction exists) ---
  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  // Which extraction approach produced this row (required - only Phase 4A+
  // code creates clause rows, and every path there is required to tag one).
  modelSource ModelSource @map("model_source")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@index([modelSource])
  @@map("document_clauses")
}

// A labeled entity span (e.g. RENT, LESSOR, LAND_AREA, SURVEY_NUMBER).
model Entity {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label      String
  text       String?

  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  // Which extraction approach produced this row (required - only Phase 4A+
  // code creates entity rows, and every path there is required to tag one).
  modelSource ModelSource @map("model_source")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  relationsAsSubject Relation[] @relation("RelationSubject")
  relationsAsObject  Relation[] @relation("RelationObject")

  @@index([documentId])
  @@index([label])
  @@index([modelSource])
  @@map("entities")
}

// A directed relation between two entities in the same document
// (e.g. LESSOR -> owns -> SURVEY_NUMBER).
model Relation {
  id              String   @id @default(uuid())
  documentId      String   @map("document_id")
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  subjectEntityId String   @map("subject_entity_id")
  subjectEntity   Entity   @relation("RelationSubject", fields: [subjectEntityId], references: [id], onDelete: Cascade)
  objectEntityId  String   @map("object_entity_id")
  objectEntity    Entity   @relation("RelationObject", fields: [objectEntityId], references: [id], onDelete: Cascade)
  relationType    String   @map("relation_type")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("relations")
}

// A flagged risk finding (Phase 6). Always framed as "potentially
// unfavorable / requires review" in `reason` - never a definitive legal
// judgment ("is illegal"/"is invalid"/"is void") - enforced by the risk
// engine's templates and tested, not just documented; see risk_engine.md.
model Risk {
  id         String       @id @default(uuid())
  documentId String       @map("document_id")
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  category   RiskCategory
  severity   RiskSeverity
  reason     String
  pass       RiskPass
  // Which entities'/clauses' model_source this finding was computed from -
  // explicit and visible, never assumed. Defaults to rule_based (the only
  // currently-reliable source - see extraction_pipeline.md /
  // evaluation_results.md) but is not hardcoded to it.
  modelSource ModelSource @map("model_source")

  // Full evidence: one element per clause/entity this finding is anchored
  // to. Pass 1 findings always have exactly one; Pass 2 findings have two
  // or more (e.g. both compared NOTICE_PERIOD clauses). Each element:
  // {sourceTable: "document_clauses"|"entities", sourceId, documentId,
  // textStart, textEnd, text} - the same provenance shape used elsewhere
  // (see provenance.md), just as an array since a single text_start/
  // text_end pair can't represent multi-span evidence.
  evidence Json

  // First evidence span, duplicated here for simple filtering/consistency
  // with the single-span provenance shape every other table uses (see
  // provenance.md) - `evidence` above is authoritative for anything
  // needing more than one span.
  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@index([category])
  @@map("risks")
}

// An extracted obligation (who owes what, optionally by when).
model Obligation {
  id           String    @id @default(uuid())
  documentId   String    @map("document_id")
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  obligedParty String?   @map("obliged_party")
  description  String?
  dueDate      DateTime? @map("due_date")

  textStart Int? @map("text_start")
  textEnd   Int? @map("text_end")

  pageNumber Int?   @map("page_number")
  bboxX      Float? @map("bbox_x")
  bboxY      Float? @map("bbox_y")
  bboxWidth  Float? @map("bbox_width")
  bboxHeight Float? @map("bbox_height")

  confidence   Float?
  modelName    String? @map("model_name")
  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("obligations")
}

// Placeholder for future vector search. `vector` is a JSON array of
// floats for now; a future migration will add the pgvector extension and
// a native `vector` column (see docs/architecture/database.md). No
// pgvector extension, column type, or dependency is added in this phase.
model Embedding {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceTable String   @map("source_table")
  sourceId    String   @map("source_id")
  modelName   String?  @map("model_name")
  dimension   Int?
  vector      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("embeddings")
}

// Tracks an async processing step for a document (text extraction, OCR,
// NER, clause classification, ...). jobType is free text (see
// TODO_PROCESSING_JOB_TYPES above); current values in use are documented
// in docs/architecture/document_ingestion.md and
// docs/architecture/extraction_pipeline.md.
model ProcessingJob {
  id           String              @id @default(uuid())
  documentId   String              @map("document_id")
  document     Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  jobType      String              @map("job_type")
  status       ProcessingJobStatus @default(PENDING)
  errorMessage String?             @map("error_message")
  startedAt    DateTime?           @map("started_at")
  finishedAt   DateTime?           @map("finished_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([documentId])
  @@map("processing_jobs")
}

// ---------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}
